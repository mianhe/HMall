#!/usr/bin/env bash
# HMall Pre-push Hook — 推送前自动测试受变更影响的 BC
# 安装：git config core.hooksPath .githooks
# 跳过：git push --no-verify
set -eo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[pre-push]${NC} 检测变更并运行受影响的测试..."

remote="$1"

# ─── 解析 stdin 获取推送范围，计算变更文件 ───
changed_files=""
while read local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD origin/master 2>/dev/null || echo "")
    if [ -n "$base" ]; then
      changed_files=$(git diff --name-only "$base" HEAD 2>/dev/null || true)
    else
      changed_files=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || true)
    fi
  elif [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    exit 0
  else
    changed_files=$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null || true)
  fi
done

if [ -z "$changed_files" ]; then
  echo -e "${GREEN}[pre-push]${NC} 无文件变更，跳过测试。"
  exit 0
fi

# ─── 将文件路径映射到服务名 ───
file_to_service() {
  case "$1" in
    services/catalog-service/*)           echo "catalog-service" ;;
    services/user-service/*)              echo "user-service" ;;
    services/order-service/*)             echo "order-service" ;;
    services/inventory-service/*)         echo "inventory-service" ;;
    services/payment-service/*)           echo "payment-service" ;;
    services/activity-service/*)          echo "activity-service" ;;
    services/cart-service/*)              echo "cart-service" ;;
    services/fulfillment-service/*)       echo "fulfillment-service" ;;
    services/smart-interaction-service/*) echo "smart-interaction-service" ;;
    services/bff-web/*)                   echo "bff-web" ;;
    pom.xml)                              echo "__ALL__" ;;
    docs/*|deploy/*|scripts/*|.github/*|.githooks/*|.cursor/*|hmall-mcp/*|*.md|.gitignore|.dockerignore)
                                          echo "__SKIP__" ;;
    *)                                    echo "__ALL__" ;;
  esac
}

ALL_SERVICES="catalog-service user-service order-service inventory-service payment-service activity-service cart-service fulfillment-service smart-interaction-service bff-web"
affected=""
test_all=false

echo "$changed_files" | while IFS= read -r file; do true; done  # just to consume

for file in $changed_files; do
  svc=$(file_to_service "$file")
  case "$svc" in
    __ALL__)  test_all=true ;;
    __SKIP__) ;;
    *)        affected="$affected $svc" ;;
  esac
done

if [ "$test_all" = true ]; then
  affected="$ALL_SERVICES"
  echo -e "${YELLOW}[pre-push]${NC} 检测到共享文件变更，运行全量测试..."
else
  affected=$(echo "$affected" | tr ' ' '\n' | sort -u | tr '\n' ' ')
  affected=$(echo "$affected" | xargs)  # trim
fi

if [ -z "$affected" ]; then
  echo -e "${GREEN}[pre-push]${NC} 变更未涉及后端服务，跳过测试。"
  exit 0
fi

echo -e "${YELLOW}[pre-push]${NC} 受影响的服务: ${affected}"

# ─── 逐个运行测试 ───
failed_services=""
pass_count=0
for svc in $affected; do
  svc_dir="${ROOT}/services/${svc}"
  if [ ! -d "$svc_dir" ]; then
    echo -e "${RED}[pre-push]${NC} 目录不存在: $svc_dir"
    failed_services="$failed_services $svc"
    continue
  fi

  echo -e "${YELLOW}[pre-push]${NC} 测试 ${svc}..."
  if (cd "$svc_dir" && mvn test -q 2>&1 | tail -3); then
    echo -e "${GREEN}[pre-push]${NC} ✓ ${svc}"
    pass_count=$((pass_count + 1))
  else
    echo -e "${RED}[pre-push]${NC} ✗ ${svc} 测试失败"
    failed_services="$failed_services $svc"
  fi
done

# ─── 汇总结果 ───
echo ""
if [ -n "$failed_services" ]; then
  echo -e "${RED}══════════════════════════════════════════${NC}"
  echo -e "${RED}  推送被阻止：以下服务测试失败${NC}"
  echo -e "${RED} ${failed_services}${NC}"
  echo -e "${RED}══════════════════════════════════════════${NC}"
  echo ""
  echo "  修复后重新 push，或使用 git push --no-verify 跳过（不推荐）"
  exit 1
else
  echo -e "${GREEN}══════════════════════════════════════════${NC}"
  echo -e "${GREEN}  所有受影响的服务测试通过 (${pass_count} services)${NC}"
  echo -e "${GREEN}══════════════════════════════════════════${NC}"
  exit 0
fi
